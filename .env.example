N8N_MCP_TOKEN=replace_with_your_token

N8N_MCP_URL=http://localhost:5678/mcp-server/http

# Planned AI Strategy Factory v0.1 service configuration.
# The service runs on macOS; n8n reaches it from its Docker container.
AI_FACTORY_HOST=127.0.0.1
AI_FACTORY_PORT=8000
AI_FACTORY_HOST_URL=http://127.0.0.1:8000
AI_FACTORY_N8N_URL=http://host.docker.internal:8000
# Use fake for deterministic tests; set ollama explicitly for local model runs.
AI_FACTORY_PROVIDER=fake
AI_FACTORY_DATA_DIR=../data
AI_FACTORY_ARTIFACT_DIR=../artifacts

# Stage 9.1 API authentication. Generate distinct values with at least 32
# characters and inject the same values into the n8n process environment.
# Never commit real tokens. Empty values keep every /v1 endpoint closed.
AI_FACTORY_SERVICE_TOKEN=
AI_FACTORY_REVIEW_TOKEN=
# Optional timezone-aware ISO 8601 expiry, for example 2026-08-01T00:00:00Z.
AI_FACTORY_SERVICE_TOKEN_EXPIRES_AT=
AI_FACTORY_REVIEW_TOKEN_EXPIRES_AT=

# Repository-managed local Ollama provider.
OLLAMA_HOST=127.0.0.1:11888
OLLAMA_BASE_URL=http://127.0.0.1:11888
OLLAMA_MODEL=gemma4:31b
OLLAMA_TIMEOUT_SECONDS=300

# Stage 7 advisory quality review. Basic is deterministic and local-only.
# Pro adds a separate Ollama critic call using the configured quality model.
AI_FACTORY_QUALITY_MODE=basic
OLLAMA_QUALITY_MODEL=gemma4:31b

# Reserved for the later OpenAIStrategyProvider. Do not use for Stage 0.
OPENAI_API_KEY=replace_only_when_openai_provider_is_implemented
