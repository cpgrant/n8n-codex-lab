      "id": "6a55fc71-0f8d-4b66-b0aa-a514beab8e74",
      "name": "Generate Quality Report"
    },
    {
      "parameters": {
        "jsCode": "const data = $json.data;\nconst report = data.quality_report;\nconst strategy = $('Create Strategy Draft').item.json.data.strategy;\nconst escapeHtml = (value) => String(value ?? '')\n  .replaceAll('&', '&amp;')\n  .replaceAll('<', '&lt;')\n  .replaceAll('>', '&gt;')\n  .replaceAll('\\\"', '&quot;')\n  .replaceAll(\"'\", '&#039;');\nconst list = (items, emptyText) => items.length\n  ? '<ul>' + items.map((item) => '<li>' + escapeHtml(item) + '</li>').join('') + '</ul>'\n  : '<p>' + escapeHtml(emptyText) + '</p>';\nconst checkRows = Object.entries(report.checks).map(([name, score]) =>\n  '<tr><td>' + escapeHtml(name.replaceAll('_', ' ')) + '</td><td>' + escapeHtml(score) + '/10</td></tr>'\n).join('');\nconst issueItems = report.issues.map((issue) =>\n  '[' + issue.severity.toUpperCase() + '] ' + issue.section + ': ' + issue.message + ' Suggestion: ' + issue.suggestion\n);\nconst reviewHtml = [\n  '<h2>Advisory quality report</h2>',\n  '<p><strong>Mode:</strong> ' + escapeHtml(report.mode) +\n    ' &nbsp; <strong>Score:</strong> ' + escapeHtml(report.overall_score) + '/100' +\n    ' &nbsp; <strong>Recommendation:</strong> ' + escapeHtml(report.recommendation) + '</p>',\n  '<p><em>This report cannot approve, reject, or rewrite the strategy. The human reviewer makes the final decision.</em></p>',\n  '<table><thead><tr><th>Check</th><th>Score</th></tr></thead><tbody>' + checkRows + '</tbody></table>',\n  '<h3>Strengths</h3>',\n  list(report.strengths, 'No strengths were recorded.'),\n  '<h3>Issues</h3>',\n  list(issueItems, 'No issues were recorded.'),\n  '<h3>Unsupported claims</h3>',\n  list(report.unsupported_claims, 'No unsupported claims were identified.'),\n  '<h3>Missing considerations</h3>',\n  list(report.missing_considerations, 'No missing considerations were identified.'),\n  '<h3>Questions for the reviewer</h3>',\n  list(report.review_questions, 'No additional questions were generated.'),\n  '<hr>',\n  '<h2>Structured strategy draft</h2>',\n  '<p><strong>Run ID:</strong> ' + escapeHtml(data.run_id) + '</p>',\n  '<h3>Executive summary</h3>',\n  '<p>' + escapeHtml(strategy.executive_summary) + '</p>',\n  '<h3>Complete structured JSON</h3>',\n  '<pre>' + escapeHtml(JSON.stringify(strategy, null, 2)) + '</pre>',\n].join('');\nreturn [{ json: { run_id: data.run_id, review_html: reviewHtml } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
