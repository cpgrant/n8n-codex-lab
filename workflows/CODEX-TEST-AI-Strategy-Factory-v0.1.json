      "id": "39cc8171-3309-48c4-acee-573a523613dc",
      "name": "JSON Upload Form",
      "webhookId": "75f1f2b9-250f-41d9-8d2c-a603f3ca20af"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst confirmation = item.json.synthetic_confirmation ?? item.json['Synthetic data confirmation'];\nif (!String(confirmation).includes('I confirm')) {\n  throw new Error('Stage 8 accepts synthetic test data only.');\n}\nconst binaryKeys = Object.keys(item.binary ?? {});\nif (binaryKeys.length !== 1) {\n  throw new Error('Upload exactly one JSON brief file.');\n}\nconst binaryKey = binaryKeys[0];\nconst metadata = item.binary[binaryKey];\nconst filename = String(metadata.fileName ?? metadata.file_name ?? '');\nif (!filename.toLowerCase().endsWith('.json')) {\n  throw new Error('The uploaded brief must use a .json extension.');\n}\nconst buffer = await helpers.getBinaryDataBuffer(0, binaryKey);\nif (buffer.length > 65536) {\n  throw new Error('The uploaded JSON brief exceeds the 64 KiB limit.');\n}\nlet parsed;\ntry {\n  parsed = JSON.parse(buffer.toString('utf8').replace(/^\\uFEFF/, ''));\n} catch {\n  throw new Error('The uploaded brief is not valid JSON.');\n}\nif (!parsed || Array.isArray(parsed) || typeof parsed !== 'object') {\n  throw new Error('The uploaded brief must be one JSON object.');\n}\nconst allowed = ['schema_version', 'title', 'organization', 'decision_horizon', 'challenge', 'desired_outcomes', 'constraints', 'available_evidence', 'stakeholders', 'requested_by', 'supersedes_run_id'];\nconst unknown = Object.keys(parsed).filter((key) => !allowed.includes(key));\nif (unknown.length) {\n  throw new Error('Unknown brief fields: ' + unknown.sort().join(', '));\n}\nif (parsed.organization && typeof parsed.organization === 'object' && !Array.isArray(parsed.organization)) {\n  const unknownOrganization = Object.keys(parsed.organization).filter((key) => !['name', 'type', 'context'].includes(key));\n  if (unknownOrganization.length) {\n    throw new Error('Unknown organization fields: ' + unknownOrganization.sort().join(', '));\n  }\n}\nreturn [{ json: { ...parsed, schema_version: parsed.schema_version ?? '0.1', supersedes_run_id: parsed.supersedes_run_id ?? null } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        220
      ],
      "id": "51c1e4e1-3c19-43b3-b5fc-18ef86cb89be",
      "name": "Parse JSON Brief"
    },
    {
      "parameters": {
        "jsCode": "const input = $json;\nconst value = (name, label) => input[name] ?? input[label] ?? '';\nconst lines = (name, label) => String(value(name, label)).split(/\\r?\\n/).map((item) => item.trim()).filter(Boolean);\nconst confirmation = value('synthetic_confirmation', 'Synthetic data confirmation');\nif (!String(confirmation).includes('I confirm')) {\n  throw new Error('Stage 8 accepts synthetic test data only.');\n}\nreturn [{\n  json: {\n    schema_version: '0.1',\n    title: String(value('title', 'Strategy title')).trim(),\n    organization: {\n      name: String(value('organization_name', 'Organization name')).trim(),\n      type: String(value('organization_type', 'Organization type')).trim(),\n      context: String(value('organization_context', 'Organization context')).trim(),\n    },\n    decision_horizon: String(value('decision_horizon', 'Decision horizon')).trim(),\n    challenge: String(value('challenge', 'Strategic challenge')).trim(),\n    desired_outcomes: lines('desired_outcomes', 'Desired outcomes (one per line)'),\n    constraints: lines('constraints', 'Constraints (one per line)'),\n    available_evidence: lines('available_evidence', 'Available evidence (one per line)'),\n    stakeholders: lines('stakeholders', 'Stakeholders (one per line)'),\n    requested_by: String(value('requested_by', 'Requested by')).trim(),\n    supersedes_run_id: null,\n  },\n}];"
      },
