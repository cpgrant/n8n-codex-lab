    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://host.docker.internal:8000/v1/strategy-runs/' + $json.data.run_id + '/quality-report' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
